{
  "name": "worker-agent-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Віртуальний працівник на Claude Agent SDK: розбір вхідних заявок (синтетичні дані)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
