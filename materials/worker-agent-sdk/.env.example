# Скопіюйте у .env (він у .gitignore) і заповніть ОДИН із варіантів. Ключ — лише ваш, не комітьте його.

# Варіант A — підтримуваний: платний ключ Anthropic (Claude Console). Модель за замовчуванням — alias "haiku".
WORKER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# WORKER_MODEL=haiku

# Варіант B — ЕКСПЕРИМЕНТ, офіційно не підтримується: безкоштовна модель OpenRouter через Anthropic-сумісний endpoint.
# WORKER_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# WORKER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Стелі одного запуску
# WORKER_MAX_TURNS=12
# WORKER_MAX_BUDGET_USD=0.20
